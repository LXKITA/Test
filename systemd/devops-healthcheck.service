[Unit]
Description=DevOps course HTTP healthcheck
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nobody
Group=nogroup
ExecStart=/usr/local/bin/healthcheck.py --url http://127.0.0.1/health --timeout 3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
